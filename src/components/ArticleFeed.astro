---
import type { CollectionEntry } from "astro:content"
import Breadcrumb from "@/components/Breadcrumb.astro"
import ArticleCard from "@/components/ArticleCard.astro"
import Pagination from "@/components/Pagination.astro"
import EmptyState from "@/components/EmptyState.astro"

interface Props {
  entries: CollectionEntry<"artikel">[]
  tags: { tag: string; count: number }[]
  seri: { seri: string; count: number }[]
  currentPage: number
  lastPage: number
  prevUrl?: string
  nextUrl?: string
}
const { entries, tags, seri, currentPage, lastPage, prevUrl, nextUrl } = Astro.props
---

<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
  <Breadcrumb items={[{ label: "Artikel" }]} />

  <header class="mb-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 border-b border-[var(--color-border)] pb-6">
    <div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium text-[var(--color-foreground)]">Arsip Tulisan</h1>
      <p class="mt-2 text-sm sm:text-base text-[var(--color-muted)] font-serif max-w-xl">
        Seluruh manuskrip komunitas: refleksi, perjalanan batin, dan ruang di antara yang tampak dan tak tampak.
      </p>
    </div>

    {
      (tags.length > 0 || seri.length > 0) && (
        <button
          id="filter-toggle"
          class="lg:hidden inline-flex items-center justify-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-xs font-mono uppercase tracking-wider text-[var(--color-foreground)] transition-colors hover:bg-[var(--color-surface-2)] active:scale-98"
          aria-expanded="false"
        >
          <span>Filter & Topik</span>
          <span aria-hidden="true">&darr;</span>
        </button>
      )
    }
  </header>

  <!-- Mobile Collapsible Filter Panel -->
  {
    (tags.length > 0 || seri.length > 0) && (
      <div id="mobile-filter-panel" class="hidden lg:hidden mb-8 p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] space-y-6">
        {seri.length > 0 && (
          <div class="space-y-3">
            <h3 class="text-xs font-mono uppercase tracking-widest text-[var(--color-primary)] font-medium border-b border-[var(--color-border-subtle)] pb-1.5">Seri Pilihan</h3>
            <div class="flex flex-wrap gap-2">
              {seri.map(({ seri: s, count }) => (
                <a
                  href={`/seri/${s}`}
                  class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-primary)]/30 bg-[var(--color-primary)]/10 px-3.5 py-1.5 text-xs font-mono uppercase tracking-wider text-[var(--color-primary)] transition-colors hover:bg-[var(--color-primary)]/20"
                >
                  {s}
                  <span class="text-[10px] opacity-75 font-sans">({count})</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {tags.length > 0 && (
          <div class="space-y-3">
            <h3 class="text-xs font-mono uppercase tracking-widest text-[var(--color-primary)] font-medium border-b border-[var(--color-border-subtle)] pb-1.5">Jelajah Tema</h3>
            <div class="flex flex-wrap gap-2">
              {tags.map(({ tag, count }) => (
                <a
                  href={`/tag/${tag}`}
                  class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border-subtle)] bg-[var(--color-surface-2)] px-3.5 py-1.5 text-xs font-mono text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors"
                >
                  #{tag}
                  <span class="text-[10px] opacity-75 font-sans">({count})</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )
  }

  <!-- Layout Grid: 2 columns on lg screens -->
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-12 items-start">
    <!-- Article List Column -->
    <div class="space-y-12">
      {
        entries.length > 0 ? (
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {entries.map((entry) => (
              <ArticleCard entry={entry} />
            ))}
          </div>
        ) : (
          <EmptyState title="Belum ada tulisan" description="Artikel akan muncul di sini setelah dipublikasikan." />
        )
      }

      <Pagination
        currentPage={currentPage}
        lastPage={lastPage}
        prevUrl={prevUrl}
        nextUrl={nextUrl}
        baseUrl="/artikel"
      />
    </div>

    <!-- Sidebar Column (Desktop only) -->
    {
      (tags.length > 0 || seri.length > 0) && (
        <aside class="hidden lg:block space-y-8 sticky top-28">
          {seri.length > 0 && (
            <div class="p-6 rounded-xl border border-[var(--color-border-subtle)] bg-[var(--color-surface)]/50 space-y-4">
              <h3 class="text-xs font-mono uppercase tracking-widest text-[var(--color-primary)] font-medium border-b border-[var(--color-border-subtle)] pb-2">
                Seri Pilihan
              </h3>
              <div class="flex flex-col gap-2">
                {seri.map(({ seri: s, count }) => (
                  <a
                    href={`/seri/${s}`}
                    class="flex items-center justify-between py-1.5 text-xs font-mono uppercase tracking-wider text-[var(--color-muted)] hover:text-[var(--color-primary)] transition-colors"
                  >
                    <span class="truncate">{s}</span>
                    <span class="text-[11px] opacity-60">({count})</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          {tags.length > 0 && (
            <div class="p-6 rounded-xl border border-[var(--color-border-subtle)] bg-[var(--color-surface)]/50 space-y-4">
              <h3 class="text-xs font-mono uppercase tracking-widest text-[var(--color-primary)] font-medium border-b border-[var(--color-border-subtle)] pb-2">
                Jelajah Tema
              </h3>
              <div class="flex flex-wrap gap-2">
                {tags.map(({ tag, count }) => (
                  <a
                    href={`/tag/${tag}`}
                    class="inline-flex items-center gap-1 rounded-full border border-[var(--color-border-subtle)] bg-[var(--color-surface-2)] px-3 py-1 text-xs font-mono text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:border-[var(--color-primary)]/40 transition-colors"
                  >
                    #{tag}
                    <span class="text-[10px] opacity-60">({count})</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </aside>
      )
    }
  </div>
</div>

<script>
  const setupToggle = () => {
    const toggleBtn = document.getElementById('filter-toggle');
    const filterPanel = document.getElementById('mobile-filter-panel');
    if (toggleBtn && filterPanel) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = filterPanel.classList.contains('hidden');
        if (isHidden) {
          filterPanel.classList.remove('hidden');
          toggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          filterPanel.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', setupToggle);
  document.addEventListener('astro:page-load', setupToggle);
</script>
