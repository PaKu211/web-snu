---
import { NAV_LINKS, SITE, QUORA_URL } from "@/config"
import { Image } from "astro:assets"
import logoImg from "@/assets/snlogo.png"
const year = new Date().getFullYear()
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]/80 mt-24">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      
      <!-- Brand & Manifesto -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="relative flex items-center justify-center h-8 w-8 rounded-full bg-black border border-[var(--color-primary)]/20 overflow-hidden shadow-sm">
            <Image src={logoImg} alt="Logo Sekala Niskala" class="h-full w-full object-cover" width={32} height={32} />
          </div>
          <span class="font-serif text-lg font-medium text-[var(--color-foreground)]">Sekala Niskala</span>
        </div>
        <p class="text-sm leading-relaxed text-[var(--color-muted)] font-serif max-w-sm">
          Ruang kesadaran dan literatur spiritual. Menyusuri kebijaksanaan masa lalu dan misteri dimensi tak kasat dengan kejernihan budi.
        </p>
      </div>

      <!-- Navigation Links -->
      <div class="md:col-span-2 space-y-3">
        <h2 class="text-[11px] font-mono uppercase tracking-widest text-[var(--color-primary)]">
          Jelajah
        </h2>
        <ul class="space-y-2 text-sm text-[var(--color-muted)]">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="hover:text-[var(--color-foreground)] transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Engagement & Support -->
      <div class="md:col-span-2 space-y-3">
        <h2 class="text-[11px] font-mono uppercase tracking-widest text-[var(--color-primary)]">
          Dukungan
        </h2>
        <ul class="space-y-2 text-sm text-[var(--color-muted)]">
          <li>
            <a href="mailto:sekalaniskalauniverse@gmail.com" class="hover:text-[var(--color-foreground)] transition-colors">
              Hubungi Kami
            </a>
          </li>
          <li>
            <a href="https://sociabuzz.com/sekalaniskala/tribe" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-foreground)] transition-colors">
              Donasi Komunitas
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="hover:text-[var(--color-foreground)] transition-colors">
              RSS Feed
            </a>
          </li>
        </ul>
      </div>

      <!-- Social & Space -->
      <div class="md:col-span-3 space-y-3">
        <h2 class="text-[11px] font-mono uppercase tracking-widest text-[var(--color-primary)]">
          Lingkar Komunitas
        </h2>
        <ul class="space-y-2 text-sm text-[var(--color-muted)]">
          <li>
            <a href={QUORA_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-foreground)] transition-colors">
              Quora Space &nearr;
            </a>
          </li>
          <li>
            <a href="https://instagram.com/sekalaniskala" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-foreground)] transition-colors">
              Instagram &nearr;
            </a>
          </li>
          <li>
            <a href="https://threads.net/@sekalaniskala_u" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-foreground)] transition-colors">
              Threads &nearr;
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="mt-14 pt-8 border-t border-[var(--color-border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[var(--color-muted)]/70">
      <p>&copy; {year} Sekala Niskala Universe. Dibatas nyata dan tak kasat.</p>
      <p class="font-serif italic text-sm text-[var(--color-muted)]">"Eling, waspada, lan rahayu."</p>
    </div>
  </div>
</footer>
