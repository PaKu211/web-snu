---
import { QUORA_URL } from "@/config"

interface Props {
  quoraUrl?: string
  class?: string
}

const {
  quoraUrl = QUORA_URL,
  class: className = ""
} = Astro.props
---

<div
  class:list={[
    "relative overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-8 sm:p-10",
    className
  ]}
>
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8 relative z-10">
    <div class="space-y-3 max-w-xl">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-[var(--color-primary)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"></span>
        <span>Lingkar Komunitas</span>
      </div>
      <h3 id="community-heading" class="font-serif text-2xl sm:text-3xl font-medium text-[var(--color-foreground)] leading-tight">
        Sekala Niskala Universe di Quora & Discord
      </h3>
      <p class="text-sm text-[var(--color-muted)] font-serif leading-relaxed">
        Ruang berdiskusi, kelas meditasi berkala, serta perjumpaan bagi para penempuh jalan kesadaran dan pecinta kisah dunia tak kasat.
      </p>
    </div>
    
    <div class="flex-shrink-0">
      <a
        href={quoraUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--color-primary)]/40 bg-[var(--color-surface-2)] px-6 py-3 text-xs font-mono uppercase tracking-wider text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-[var(--color-primary-foreground)] transition-all shadow-sm"
      >
        <span>Masuk ke Quora Space</span>
        <span>&nearr;</span>
      </a>
    </div>
  </div>
</div>
