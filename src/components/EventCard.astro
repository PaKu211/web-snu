---
import type { CollectionEntry } from "astro:content"
import { Image } from "astro:assets"
import EventStatus from "@/components/EventStatus.astro"
import { formatDate } from "@/lib/utils"
import coverTemple from "@/assets/cover_temple.jpg"
import coverMeditation from "@/assets/cover_meditation.jpg"

interface Props {
  event: CollectionEntry<"events">
  class?: string
}

const { event, class: className = "" } = Astro.props
const { title, description, startDate, location, cover } = event.data

const fallbackCovers = [
  coverTemple,
  coverMeditation,
]
const finalCover = cover || fallbackCovers[event.id.charCodeAt(0) % fallbackCovers.length]
const href = `/events/${event.id || event.slug}`
---

<article
  class:list={[
    "group flex flex-col h-full rounded-xl border border-[var(--color-border-subtle)] bg-[var(--color-surface)]/50 p-5 sm:p-6 hover:bg-[var(--color-surface)] hover:border-[var(--color-border)] transition-all duration-300",
    className
  ]}
>
  <div class="relative aspect-[16/9] w-full bg-[var(--color-surface-2)] overflow-hidden rounded-lg border border-[var(--color-border-subtle)] mb-5">
    {
      finalCover && (
        <Image
          src={finalCover}
          alt={`Ilustrasi untuk event ${title}`}
          width={400}
          height={225}
          class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-103"
        />
      )
    }
    <div class="absolute right-3 top-3">
      <EventStatus startDate={startDate} endDate={event.data.endDate} />
    </div>
  </div>

  <div class="flex flex-1 flex-col justify-between">
    <div>
      <div class="mb-2.5 flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-[var(--color-primary)]">
        <span>{formatDate(startDate)}</span>
        <span class="opacity-40">&middot;</span>
        <span class="truncate max-w-[150px]">{location}</span>
      </div>

      <h3 class="font-serif text-xl font-medium leading-snug text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors">
        <a href={href}>{title}</a>
      </h3>

      <p class="mt-2.5 text-sm text-[var(--color-muted)] font-serif line-clamp-3 leading-relaxed">
        {description}
      </p>
    </div>

    <div class="mt-6 pt-4 border-t border-[var(--color-border-subtle)] flex items-center justify-between text-xs font-mono">
      <a href={href} class="text-[var(--color-primary)] hover:underline flex items-center gap-1">
        Detail & Pendaftaran &rarr;
      </a>
    </div>
  </div>
</article>
