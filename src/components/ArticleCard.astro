---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "@/lib/utils"
import SeriBadge from "@/components/SeriBadge.astro"
import { TAG_META } from "@/config"

interface Props {
  entry: CollectionEntry<"artikel">
  featured?: boolean
  loading?: "lazy" | "eager"
}

const { entry, featured = false, loading = "lazy" } = Astro.props
const { title, description, author, publishDate, tags, seri, cover, draft } = entry.data

// Calculate estimated reading time using entry body
const readTime = entry.body ? readingTime(entry.body) : Math.max(2, Math.round(description.split(/\s+/).length / 20))
const href = `/artikel/${entry.id}`
const finalCover = cover
---

{
  featured ? (
    <!-- Featured Editorial Hero Card (Horizontal Asymmetric) -->
    <article class="group relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center p-6 sm:p-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 hover:bg-[var(--color-surface)] transition-all duration-500 hover:border-[var(--color-primary)]/40 shadow-sm">
      {finalCover && (
        <a href={href} class="lg:col-span-7 relative aspect-[16/10] overflow-hidden rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-border-subtle)]" aria-label={`Baca karya pilihan: ${title}`}>
          <Image
            src={finalCover}
            alt=""
            loading={loading}
            widths={[600, 1000]}
            sizes="(min-width: 1024px) 58vw, 100vw"
            class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-103"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-40 group-hover:opacity-20 transition-opacity"></div>
        </a>
      )}

      <div class:list={["flex flex-col justify-center", finalCover ? "lg:col-span-5" : "lg:col-span-12"]}>
        <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono uppercase tracking-widest text-[var(--color-primary)] mb-4">
          <span class="px-2.5 py-0.5 rounded border border-[var(--color-primary)]/30 bg-[var(--color-primary)]/10 font-semibold">
            Karya Utama
          </span>
          {seri && <span class="text-[var(--color-muted)]">&middot; Seri {seri}</span>}
          {draft && <span class="text-amber-500/80">[Draf]</span>}
        </div>

        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-normal leading-[1.15] text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors text-balance">
          <a href={href}>
            {title}
          </a>
        </h2>

        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[var(--color-muted)] font-serif line-clamp-3">
          {description}
        </p>

        <div class="mt-8 pt-5 border-t border-[var(--color-border-subtle)] flex items-center justify-between text-xs text-[var(--color-muted)] font-mono">
          <div>
            <span class="text-[var(--color-foreground)] font-medium">{author}</span>
            <span class="mx-1.5 opacity-40">&middot;</span>
            <span>{formatDate(publishDate)}</span>
          </div>
          <span class="text-[var(--color-primary)] font-medium flex items-center gap-1 group-hover:translate-x-1 transition-transform">
            Baca Tulisan &rarr;
          </span>
        </div>
      </div>
    </article>
  ) : (
    <!-- Standard Editorial Grid Card -->
    <article class="group flex flex-col h-full rounded-xl border border-[var(--color-border-subtle)] bg-[var(--color-surface)]/40 p-5 hover:bg-[var(--color-surface)] hover:border-[var(--color-border)] transition-all duration-300">
      {finalCover && (
        <a href={href} class="relative aspect-[16/10] mb-5 overflow-hidden rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-border-subtle)]" aria-label={`Baca: ${title}`}>
          <Image
            src={finalCover}
            alt=""
            loading={loading}
            widths={[400, 700]}
            sizes="(min-width: 768px) 33vw, 100vw"
            class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-103"
          />
        </a>
      )}

      <div class="flex flex-1 flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-wider text-[var(--color-muted)] mb-2.5">
            {tags && tags[0] && (
              <span class="text-[var(--color-primary)]">
                #{tags[0]}
              </span>
            )}
            {seri && <span>&middot; {seri}</span>}
            <span class="ml-auto opacity-75">{readTime}m baca</span>
          </div>

          <h3 class="font-serif text-xl font-medium leading-snug text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors">
            <a href={href}>
              {title}
            </a>
          </h3>

          <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-[var(--color-muted)] font-serif line-clamp-2">
            {description}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[var(--color-border-subtle)] flex items-center justify-between text-[11px] font-mono text-[var(--color-muted)]">
          <span class="truncate max-w-[140px]">{author}</span>
          <span class="opacity-70">{formatDate(publishDate)}</span>
        </div>
      </div>
    </article>
  )
}
