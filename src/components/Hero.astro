---
import { SITE, QUORA_URL } from "@/config"

interface Props {
  eyebrow?: string
  title?: string
  subtitle?: string
}

const {
  eyebrow = "SEKALA · NISKALA UNIVERSE — VOL. I",
  title = "Di Batas Nyata dan Tak Kasat",
  subtitle = "Di sinilah kita berkumpul, dalam ekosistem di mana batas antara yang terlihat dan yang gaib berpadu. Menjelajahi kesadaran batin, kisah leluhur, dan misteri semesta.",
} = Astro.props
---

<section class="relative min-h-[82dvh] flex items-center justify-center overflow-hidden border-b border-[var(--color-border)] py-20 sm:py-28">
  <!-- Mystical Ambient Imagery with Soft Cinematic Obsidian Mask -->
  <div 
    class="absolute inset-0 z-0 bg-[url('/hero_bg.jpg')] bg-cover bg-center bg-no-repeat opacity-35 scale-105 transition-transform duration-1000 ease-out"
    aria-hidden="true"
  ></div>
  
  <div 
    class="absolute inset-0 z-0 bg-gradient-to-b from-[var(--color-background)]/60 via-[var(--color-background)]/80 to-[var(--color-background)]"
    aria-hidden="true"
  ></div>

  <!-- Soft Vignette Framing -->
  <div class="absolute inset-0 z-0 shadow-[inset_0_0_120px_rgba(0,0,0,0.8)] pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center w-full">
    <div class="flex flex-col items-center">
      
      <!-- Editorial Edition / Masthead Eyebrow -->
      <div class="inline-flex items-center gap-3 mb-6">
        <span class="h-[1px] w-8 bg-[var(--color-primary)]/40" aria-hidden="true"></span>
        <span class="text-[11px] font-mono uppercase tracking-[0.3em] text-[var(--color-primary)] font-medium">
          {eyebrow}
        </span>
        <span class="h-[1px] w-8 bg-[var(--color-primary)]/40" aria-hidden="true"></span>
      </div>
      
      <!-- Cormorant Monumental Serif Title -->
      <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-normal leading-[1.08] tracking-tight text-[var(--color-foreground)] max-w-3xl text-balance">
        {title}
      </h1>
      
      <!-- Literary Lede -->
      <p class="mt-7 max-w-2xl text-base sm:text-lg leading-relaxed text-[var(--color-muted)] font-serif italic text-balance">
        "{subtitle}"
      </p>

      <!-- Editorial Navigational Anchors -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-4 text-xs font-mono">
        <a 
          href="/artikel"
          class="inline-flex items-center gap-2 rounded-full border border-[var(--color-primary)]/40 bg-[var(--color-surface)]/80 px-6 py-3 text-[var(--color-primary)] transition-all duration-300 hover:bg-[var(--color-primary)] hover:text-[var(--color-primary-foreground)] hover:border-[var(--color-primary)] shadow-sm"
        >
          <span>Buka Arsip Tulisan</span>
          <span aria-hidden="true">&darr;</span>
        </a>
        
        <a 
          href={QUORA_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-5 py-3 text-[var(--color-muted)] transition-colors hover:text-[var(--color-foreground)]"
        >
          <span>Ruang Komunitas Quora</span>
          <span class="text-[10px] opacity-60">&nearr;</span>
        </a>
      </div>

      <!-- Quick Curated Topics Hairline Navigation -->
      <div class="mt-14 pt-8 border-t border-[var(--color-border-subtle)] flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[11px] font-mono tracking-widest uppercase text-[var(--color-muted)]/80">
        <span class="text-[var(--color-primary)]/60">Fokus Bacaan:</span>
        <a href="/tag/spiritual" class="hover:text-[var(--color-primary)] transition-colors">01. Batin & Kesadaran</a>
        <a href="/seri/wpm-saga" class="hover:text-[var(--color-primary)] transition-colors">02. WPM [SAGA]</a>
        <a href="/tag/misteri" class="hover:text-[var(--color-primary)] transition-colors">03. Lore & Gaib</a>
      </div>

    </div>
  </div>
</section>
