---
import { getCollection } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import Hero from "@/components/Hero.astro"
import ArticleCard from "@/components/ArticleCard.astro"
import EmptyState from "@/components/EmptyState.astro"
import EventCard from "@/components/EventCard.astro"
import CommunityBanner from "@/components/CommunityBanner.astro"
import { collectTags, sortArtikel, formatDate } from "@/lib/utils"

const all = sortArtikel(await getCollection("artikel"))
const featured = all.find((a) => a.data.featured) ?? all[0]
const rest = all.filter((a) => a.id !== featured?.id).slice(0, 6)
const tags = collectTags(all).slice(0, 6)

const quoraArticles = all.filter((a) => a.data.tags?.includes("quora-sync")).slice(0, 3)

// Retrieve upcoming events
const allEvents = await getCollection("events", ({ data }) => import.meta.env.DEV || !data.draft)
const now = new Date()
const upcomingEvents = allEvents
  .filter((e) => {
    const end = e.data.endDate ?? new Date(e.data.startDate.getTime() + 24 * 60 * 60 * 1000)
    return end >= now
  })
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
  .slice(0, 2)
---

<BaseLayout>
  <Hero />

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 space-y-24">
    
    <!-- 01. Featured Article (Karya Terpilih) -->
    {
      featured && (
        <section class="reveal-on-scroll" aria-labelledby="featured-heading">
          <div class="mb-6 flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-[var(--color-primary)]">01.</span>
              <h2 id="featured-heading" class="font-serif text-2xl sm:text-3xl font-medium tracking-tight text-[var(--color-foreground)]">
                Karya Pilihan Redaksi
              </h2>
            </div>
            <span class="text-xs font-mono text-[var(--color-muted)] uppercase tracking-widest hidden sm:inline-block">
              Manuskrip Utama
            </span>
          </div>
          <ArticleCard entry={featured} featured loading="eager" />
        </section>
      )
    }

    <!-- 02. Curated Themes (Jelajahi Berdasarkan Tema) -->
    {
      tags.length > 0 && (
        <section class="reveal-on-scroll" aria-labelledby="tags-heading">
          <div class="mb-6 flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-[var(--color-primary)]">02.</span>
              <h2 id="tags-heading" class="font-serif text-2xl sm:text-3xl font-medium tracking-tight text-[var(--color-foreground)]">
                Arsip & Ruang Tematik
              </h2>
            </div>
            <a href="/artikel" class="text-xs font-mono text-[var(--color-primary)] hover:underline uppercase tracking-wider">
              Semua Topik &rarr;
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            {tags.map(({ tag, count }) => (
              <a
                href={`/tag/${tag}`}
                class="group p-4 rounded-lg border border-[var(--color-border-subtle)] bg-[var(--color-surface)]/50 hover:bg-[var(--color-surface)] hover:border-[var(--color-primary)]/40 transition-all text-center flex flex-col justify-center items-center gap-1.5"
              >
                <span class="font-serif text-base text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors capitalize">
                  {tag}
                </span>
                <span class="text-[10px] font-mono text-[var(--color-muted)]">
                  {count} Naskah
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- 03. Latest Articles (Koleksi Tulisan Terbaru) -->
    <section aria-labelledby="latest-heading" class="reveal-on-scroll">
      <div class="mb-8 flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono text-[var(--color-primary)]">03.</span>
          <h2 id="latest-heading" class="font-serif text-2xl sm:text-3xl font-medium tracking-tight text-[var(--color-foreground)]">
            Tulisan Terkini
          </h2>
        </div>
        <a href="/artikel" class="text-xs font-mono text-[var(--color-primary)] hover:underline uppercase tracking-wider">
          Buka Seluruh Arsip &rarr;
        </a>
      </div>

      {
        rest.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {rest.map((entry) => (
              <ArticleCard entry={entry} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="Belum ada tulisan"
            description="Artikel pertama akan segera hadir di ruang ini."
          />
        )
      }
    </section>

    <!-- 04. Upcoming Events (Agenda & Pertemuan) -->
    {
      upcomingEvents.length > 0 && (
        <section class="reveal-on-scroll" aria-labelledby="upcoming-events-heading">
          <div class="mb-8 flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-[var(--color-primary)]">04.</span>
              <h2 id="upcoming-events-heading" class="font-serif text-2xl sm:text-3xl font-medium tracking-tight text-[var(--color-foreground)]">
                Agenda & Pertemuan
              </h2>
            </div>
            <a href="/events" class="text-xs font-mono text-[var(--color-primary)] hover:underline uppercase tracking-wider">
              Semua Kegiatan &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {upcomingEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        </section>
      )
    }

    <!-- 05. Community Banner & Call to Sanctuary -->
    <section class="reveal-on-scroll" aria-labelledby="community-heading">
      <CommunityBanner />
    </section>

  </div>
</BaseLayout>
